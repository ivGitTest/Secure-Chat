# ─────────────────────────────────────────────────────────────────────────────
# Family Messenger — production environment variables
# Copy this file to .env and fill in every value before running docker compose.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ───────────────────────────────────────────────────────────────────
# The public domain name of your VPS (used by nginx and TURN config).
DOMAIN=chat.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the `messenger` database user (choose a strong random password).
POSTGRES_PASSWORD=change_me_strong_password

# Host directory where PostgreSQL stores its data files.
# This is a bind mount, so the data survives `docker compose down -v` and
# `docker volume prune`. Change the path only before the first run.
POSTGRES_DATA_DIR=/opt/messenger/postgres-data

# ── API Server ────────────────────────────────────────────────────────────────
# Secret used to sign JWTs (minimum 32 random characters).
JWT_SECRET=change_me_jwt_secret_min_32_chars

# JWT token lifetime. Supported suffixes: s (seconds), m (minutes), h (hours),
# d (days), w (weeks). Examples: 7d = 7 days, 24h = 24 hours, 3600s = 1 hour.
JWT_EXPIRES_IN=7d

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── TURN Server ───────────────────────────────────────────────────────────────
# Shared secret for HMAC-based TURN credentials (minimum 32 random characters).
TURN_SECRET=change_me_turn_secret_min_32_chars

# TURN realm — typically your domain name.
TURN_REALM=chat.example.com

# Public IP address of your VPS (required for coturn relay).
# Find it with: curl -s https://ifconfig.me
EXTERNAL_IP=1.2.3.4

# ── Firebase (VoIP call push notifications) ──────────────────────────────────
# Service account JSON for Firebase Admin SDK — used to send data-only FCM
# pushes directly to Android devices for incoming call notifications.
# This is the only way to wake a killed app and show the system call screen.
#
# How to get it:
#   Firebase Console → Project Settings → Service accounts
#   → Generate new private key → download the JSON
#   Paste the entire JSON content on ONE line below (no newlines inside).
#
# OPTIONAL: if not set, the server falls back to Expo push (regular banner).
FIREBASE_SERVICE_ACCOUNT_JSON=
