{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote"
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "prebuildCommand": "expo prebuild --platform android --no-install && node scripts/fix-android-manifest.js"
    },
    "production": {
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "prebuildCommand": "expo prebuild --platform android --no-install && node scripts/fix-android-manifest.js"
    }
  },
  "submit": {
    "production": {}
  }
}
